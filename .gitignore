# secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
keystore/
wallets/

# node
node_modules/
npm-debug.log*
*.tgz

# rust / ckb build output
target/
build/
*.wasm

# compiled ckb script bytecode (rebuilt with `npm run build`)
dist/

# offckb deployment migration records are machine + run specific
**/deployment/*/*/migrations/

# offckb local state
.offckb/
devnet/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.next/
next-env.d.ts
*.tsbuildinfo
.vercel/

# playwright output
e2e/test-results/
e2e/playwright-report/

# mainnet cycle atlas: a run's scratch state (data.json and report.md are kept)
atlas/**/progress.jsonl
atlas/**/run.json
atlas/**/targeted-progress.jsonl

# the testtool fixture project commits its stripped contract build
!test/fixtures/testtool-project/build/

# ckb-debugger releases fetched by `npm run compat -- fetch`
.cache/
